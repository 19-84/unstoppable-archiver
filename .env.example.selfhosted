# Self-hosted deployment (single user, local only)
# Copy to .env and edit as needed:
#   cp .env.example.selfhosted .env

# Database password (any string; just don't leave the default)
ARCHIVER_DB_PASSWORD=change-me

# --- Optional: enable admin UI ---
# Uncomment to protect /admin/* and enable takedown capability.
# Generate a bcrypt hash:
#   docker compose run --rm app uv run python scripts/hash_password.py
# ARCHIVER_ADMIN_PASSWORD_HASH=
# ARCHIVER_SESSION_SECRET=  # generate: openssl rand -hex 32

# --- Optional: blocklist (rarely needed for personal use) ---
# ARCHIVER_BLOCKLIST_DOMAINS=malicious-site.example,scam.test
# ARCHIVER_BLOCKLIST_URLS=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
# ARCHIVER_ALLOWLIST_DOMAINS=false-positive.example
