# Self-hosted deployment (single user, local only)
# Copy to .env and edit as needed:
#   cp .env.example.selfhosted .env

# Database password (any string; just don't leave the default)
ARCHIVER_DB_PASSWORD=change-me

# --- Optional: enable admin UI ---
# Uncomment to protect /admin/* and enable takedown capability.
# Generate a bcrypt hash:
#   docker compose run --rm app uv run python scripts/hash_password.py
# ARCHIVER_ADMIN_PASSWORD_HASH=
# ARCHIVER_SESSION_SECRET=  # generate: openssl rand -hex 32

# --- Optional: blocklist (rarely needed for personal use) ---
# ARCHIVER_BLOCKLIST_DOMAINS=malicious-site.example,scam.test
# ARCHIVER_BLOCKLIST_URLS=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
# ARCHIVER_ALLOWLIST_DOMAINS=false-positive.example

# --- Optional: proxy pool (camoufox_proxy tier + archive.today submit) ---
# Only needed when a site walls the direct browser tiers, or to reach
# the archive.today write path (its CF+captcha gate walls datacenter IPs).
# The compose file already points ARCHIVER_PROXY_LIST_URLS at curated free
# SOCKS5 lists; they work but churn fast and clear the archive.today gate
# only ~25% of the time. For anything you rely on, use a paid RESIDENTIAL
# provider instead — same pipeline (health-check -> ASN filter -> gate
# probe) runs over whatever you supply, and most residential IPs survive.
#
# Point ARCHIVER_PROXY_LIST at the provider's SOCKS5 endpoint(s). One
# rotating gateway is enough — the provider rotates the exit IP per
# connection. Credentials go in the URL. Examples (pick your provider):
#   IPRoyal:    socks5://USER:PASS@geo.iproyal.com:32325
#   Bright Data socks5://brd-customer-<id>-zone-residential:PASS@brd.superproxy.io:22225
#   Oxylabs:    socks5://customer-USER:PASS@pr.oxylabs.io:7777
# ARCHIVER_PROXY_LIST=socks5://USER:PASS@geo.iproyal.com:32325
#
# When you supply a rotating residential gateway, turn OFF the free
# public lists so the pool isn't diluted with dead/datacenter entries:
# ARCHIVER_PROXY_LIST_URLS=
#
# Bare "host:port" entries (no scheme) are assumed to use this scheme.
# Residential providers are SOCKS5; the archive.today gate rejects HTTP.
# ARCHIVER_PROXY_DEFAULT_SCHEME=socks5
#
# A rotating gateway is a single alias in front of a huge IP pool, so the
# startup health check adds little — disable it to avoid gating the whole
# pool on one probe of the shared endpoint:
# ARCHIVER_PROXY_HEALTH_CHECK_ENABLED=false
