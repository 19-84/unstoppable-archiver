# Public deployment (archive.today-style)
# Use ./scripts/setup-public.sh to generate this automatically,
# or copy and fill in the required fields manually:
#   cp .env.example.public .env

# --- REQUIRED ---

# Database password — pick a strong one
ARCHIVER_DB_PASSWORD=

# Admin password hash (bcrypt)
# Generate:
#   docker compose run --rm app uv run python scripts/hash_password.py
ARCHIVER_ADMIN_PASSWORD_HASH=

# Session cookie signing key (32+ random bytes)
# Generate: openssl rand -hex 32
ARCHIVER_SESSION_SECRET=

# Public domain — DNS A/AAAA must point at this host BEFORE startup,
# otherwise Caddy's Let's Encrypt ACME HTTP-01 challenge fails.
ARCHIVER_PUBLIC_DOMAIN=

# ACME contact email — Let's Encrypt sends cert-expiry notifications
# here. Use a monitored mailbox.
ARCHIVER_ACME_EMAIL=

# --- RECOMMENDED ---

# Domain blocklist — curated GitHub lists of domains to refuse
# Multiple URLs can be comma-separated; results are unioned
ARCHIVER_BLOCKLIST_URLS=https://raw.githubusercontent.com/StevenBlack/hosts/master/alternates/porn/hosts

# Inline extra domains to block
ARCHIVER_BLOCKLIST_DOMAINS=

# Allowlist overrides (for false positives in the remote list)
ARCHIVER_ALLOWLIST_DOMAINS=

# Rate limits (defaults: 60 submits/hr/ip, 10 reports/hr/ip)
# ARCHIVER_RATE_LIMIT_SUBMIT_PER_HOUR=60
# ARCHIVER_RATE_LIMIT_REPORT_PER_HOUR=10

# --- OPTIONAL: proxy pool (camoufox_proxy tier + archive.today submit) ---
# Powers the camoufox_proxy escalation tier and the last-resort
# archive.today write path. archive.today's submission form sits behind
# a Cloudflare + captcha gate that walls datacenter IPs almost 100% of
# the time, so a public deployment that wants that tier to actually land
# needs clean egress IPs.
#
# The compose file ships ARCHIVER_PROXY_LIST_URLS pointed at curated free
# SOCKS5 lists. They cost nothing but are unreliable — a live pull is
# typically <1% reachable and clears the archive.today gate only ~25% of
# the time. For a public instance, prefer a paid RESIDENTIAL provider:
# the same pipeline (health-check -> datacenter-ASN filter -> live gate
# probe) filters whatever you supply, and residential IPs mostly pass.
#
# Point ARCHIVER_PROXY_LIST at the provider's rotating SOCKS5 gateway
# (one endpoint is enough — the exit IP rotates per connection):
#   IPRoyal:     socks5://USER:PASS@geo.iproyal.com:32325
#   Bright Data: socks5://brd-customer-<id>-zone-residential:PASS@brd.superproxy.io:22225
#   Oxylabs:     socks5://customer-USER:PASS@pr.oxylabs.io:7777
# ARCHIVER_PROXY_LIST=

# With a residential gateway set, disable the free lists so the pool
# isn't diluted, default bare entries to SOCKS5, and skip the startup
# health check (one alias fronts the whole rotating pool):
# ARCHIVER_PROXY_LIST_URLS=
# ARCHIVER_PROXY_DEFAULT_SCHEME=socks5
# ARCHIVER_PROXY_HEALTH_CHECK_ENABLED=false

# --- OPTIONAL: captcha ---
# "none" (default), "hcaptcha", or "altcha"

# ARCHIVER_CAPTCHA_PROVIDER=altcha
# ARCHIVER_ALTCHA_HMAC_KEY=  # generate: openssl rand -hex 32

# Or hCaptcha (requires signup at hcaptcha.com):
# ARCHIVER_CAPTCHA_PROVIDER=hcaptcha
# ARCHIVER_HCAPTCHA_SITEKEY=
# ARCHIVER_HCAPTCHA_SECRET=
